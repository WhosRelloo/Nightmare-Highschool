	["NHAcc_ThornCrown_color"] = 93321066384730;
	["NHAcc_ThornCrown_emissive"] = 90133939469814;
	["NHAcc_ThornCrown_metalness"] = 133103969274929;
	["NHAcc_ThornCrown_normal"] = 80474061443970;
