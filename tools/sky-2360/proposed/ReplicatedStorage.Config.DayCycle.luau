				{ 1, Witching };
				{ 4, Witching };
				{ 5, Night };
				{ 6, Dawn };
				{ 7.5, Morning };
				{ 9.5, Day };
				{ 17, Day };
				{ 18, Golden };
				{ 19.5, Dusk };
				{ 21, Night };
				{ 24, Night };
			};
			Schedule = {
				{ 0, `Night` };
				{ 5.6, `Dawn` };
				{ 8.0, `Day` };
				{ 18.6, `Dusk` };
				{ 20.6, `Night` };
			};
		};
		Nightmare = {
			Skies = { Dusk = `NightmareDusk`; Night = `NightmareNight` };
			Looks = {
				Dusk = { ColorShiftTop = rgb(255, 90, 80); AtmosphereColor = rgb(200, 90, 80); CloudColor = rgb(200, 70, 70); Tint = rgb(255, 214, 206); };
			};
			Moon = `Crimson`;
		};
	};

	-- Painted skies. Art: tools/vfx/make_skyboxes.py (+ tools/vfx/skies2360.py) -> art/group-upload-skies
	-- (NHSky<Set>_<Face>.png, 1024). A set with any id 0 is skipped and the place's own Sky stays, so sets can be filled
	-- one at a time. Only the six Skybox faces and SkyboxOrientation are written; the moon texture, its size and StarCount
	-- stay World.FullMoon's / World.MoonPhases'.
	Skies = {
		Enabled = true;
		SwapSeconds = 3;   -- two Sky layers can't blend: the haze swells over this long and the faces change at its peak
		SwapHaze = 1.2;    -- the extra Atmosphere.Haze at the peak of a swap
		-- (2.36) preload only the shown set and the next one in the schedule (plus Storm when NHSky is set); event sets
		-- load only while their event is on. 2.16 preloaded every set, which is too much memory at 19 sets.
		Preload = `ShownAndNext`;
		-- { from hour, set }: sorted; the last runs past midnight into the first. Dawn is its own painting now, so
		-- there is no SkyboxOrientation turn (the Atmosphere ignores the turn and could show a seam).
		Schedule = {
			{ 0, `Night` };
			{ 5.6, `Dawn` };
			{ 8.0, `Day` };
			{ 17.6, `Dusk` };
			{ 19.6, `Night` };
		};
		BlueMoon = `NightBlue`;   -- 2.16 field, kept for the old controller; 2.36 reads Moon.Blue.Sky
		-- workspace attribute NHSky = "Storm" (a set name) overrides the schedule, for weather or an admin;
		-- the LocalPlayer attribute NHSkyPreview does the same on one client, for testing.
		Sets = {
			Day = { Bk = 103651333736497; Dn = 77333463665975; Ft = 119988626923704; Lf = 82325193338630; Rt = 98736878816049; Up = 96123202776655 };  -- 2026-11-13 upload, unchanged
			Dusk = { Bk = 130059050523371; Dn = 109620867877755; Ft = 134244672227710; Lf = 92637844935076; Rt = 123188875952160; Up = 104447967963998 };  -- 2026-11-13 upload, unchanged
			Dawn = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			Night = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };  -- repainted for 2.36: upload the new faces (2.16 ids in Sets216)
			NightNew = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			NightCrimson = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			NightBlue = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };  -- repainted for 2.36: upload the new faces (2.16 ids in Sets216)
			Storm = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };  -- repainted for 2.36: upload the new faces (2.16 ids in Sets216)
			WinterDay = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			WinterDusk = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			WinterNight = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			SpringDay = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			SpringDusk = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			SpringNight = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			SummerDay = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			SummerDusk = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			SummerNight = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			NightmareDusk = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
			NightmareNight = { Bk = 0; Dn = 0; Ft = 0; Lf = 0; Rt = 0; Up = 0 };
		};
		-- the 2.16 paintings, live until the 2.36 faces are uploaded (copy back into Sets to roll back)
		Sets216 = {
			Night = { Bk = 125002822187171; Dn = 84581077978179; Ft = 111974113063539; Lf = 129398379328271; Rt = 103371164387111; Up = 71407617919019 };
			NightBlue = { Bk = 79114995657347; Dn = 125521770406965; Ft = 137444634128484; Lf = 139377898630563; Rt = 114576978634954; Up = 83837514923669 };
			Storm = { Bk = 140004647918133; Dn = 75870366649344; Ft = 138974617955349; Lf = 81795809687373; Rt = 128479768841317; Up = 127658888445040 };
		};
	};

	-- (2.36) Controllers.World.SkyMotion. Tier = the game's own Effects Quality setting (High / Medium / Low), demoted one
	-- step while the average frame time stays over SlowFrameMs for SlowSeconds. Never reads SavedQualityLevel.
	Motion = {
		Enabled = true;
		SlowFrameMs = 22; SlowSeconds = 5;
		Clouds = { WindStuds = Vector3.new(6, 0, 3); StormMultiplier = 3; LowMultiplier = 0.5 };   -- workspace.GlobalWind
		Wisps = {
			-- NHWisp_A / NHWisp_B (1024 x 256, tiling in U, white with alpha; Beam.Color tints them by the key's CloudColor)
			Textures = { A = 0; B = 0 };
			Beams = { High = 3; Medium = 1; Low = 0 };
			TextureSpeed = { 0.01, 0.03 };
			Radius = 1500;   -- studs from the camera anchor; their band crosses the moon's path
			FadeIn = { 18.5, 20 }; FadeOut = { 5, 6.5 };   -- hours: 0 at dusk, 1 at night (same as NightWeight)
		};
		Storm = { MinGap = 6; MaxGap = 18; Flickers = { 2, 3 }; FlickerSeconds = { 0.08, 0.25 }; MaxHz = 3;
			Glare = 1.2; Haze = 0.8; GradeBrightness = 0.12 };   -- never white; Reduce Flashing = one soft pulse
		SkyTurn = { Enabled = false; DegreesPerHour = 2 };   -- ships only if Studio shows no Atmosphere seam at QL21 and QL1
	};
}
