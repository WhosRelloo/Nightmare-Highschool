				Dusk = { ColorShiftTop = rgb(255, 170, 170); CloudColor = rgb(240, 170, 190); };
				Night = { Density = 0.36; };
			};
		};
		Summer = {
			Skies = { Day = `SummerDay`; Dusk = `SummerDusk`; Night = `SummerNight` };
			Looks = {
				Day = { Brightness = 3.2; Haze = 0.2; Density = 0.25; ColorShiftTop = rgb(255, 240, 210); };
