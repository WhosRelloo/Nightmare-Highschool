return {
	Enabled = true;
	UpdateSeconds = 0.2;   -- how often the grade is re-blended (the clock moves slowly)
	-- { hour, look }, sorted; the first and last wrap around midnight
	Keys = {
		{ 0, Night };
		{ 1, Witching };
		{ 4, Witching };
		{ 5, Night };
		{ 6, Dawn };
		{ 7.5, Morning };
		{ 9.5, Day };
		{ 16, Day };
		{ 17, Golden };
		{ 18.5, Dusk };
		{ 20, Night };
		{ 24, Night };
	};
	Looks = { Dawn = Dawn; Morning = Morning; Day = Day; Golden = Golden; Dusk = Dusk; Night = Night; Witching = Witching };

	-- (2.36) how much night it is (0..1): moon modifiers are scaled by it
	NightWeight = { Rise = { 18.5, 20.0 }; Fall = { 5.0, 6.5 } };
	-- (2.36) moon modifiers, on top of the blended key. The phase comes from Lineage (World.MoonPhases); an event
	-- moon from workspace NHMoonEventTonight ("Crimson" / "Blue"). Mul multiplies, Add adds, Set lerps to the
	-- value, all by NightWeight. These replace World.FullMoon's NHMoonGrade and World.MoonPhases' NHNewMoonGrade.
	Moon = {
		Full = {
			Mul = { Brightness = 1.25; };
			Add = { ExposureCompensation = 0.05; };
		};
		Waxing = { };
		Waning = { };
		New = {
			Mul = { Brightness = 0.4; };
			Add = { Ambient = rgb(6, 6, 12); Saturation = -0.12; };
			Set = { Tint = rgb(210, 216, 255); };
			Sky = `NightNew`;
			StarCount = 5000;  -- applied by World.MoonPhases (it owns the stars)
		};
		Crimson = {
			Add = { Contrast = 0.04; };
			Set = { OutdoorAmbient = rgb(130, 70, 84); ColorShiftTop = rgb(255, 120, 120); AtmosphereColor = rgb(150, 70, 80); Decay = rgb(70, 20, 30); CloudColor = rgb(180, 80, 90); Tint = rgb(255, 214, 214); };
			Sky = `NightCrimson`;
		};
		Blue = {
			Set = { OutdoorAmbient = rgb(90, 130, 190); ColorShiftTop = rgb(160, 210, 255); AtmosphereColor = rgb(90, 130, 180); Tint = rgb(210, 232, 255); };
			Sky = `NightBlue`;
		};
	};

	-- (2.36) event seasons: workspace attribute NHSeason = "Winter" | "Spring" | "Summer" | "Nightmare" (nil = Autumn).
	-- Skies swaps the set for a schedule slot; Looks are partial overrides by key name; Keys/Schedule replace the
	-- whole list (summer's later evening); Moon forces a moon modifier every night.
	Seasons = {
		Winter = {
			Skies = { Day = `WinterDay`; Dusk = `WinterDusk`; Night = `WinterNight` };
			Looks = {
				Morning = { OutdoorAmbient = rgb(114, 118, 130); CloudColor = rgb(232, 236, 244); };
				Day = { OutdoorAmbient = rgb(120, 126, 140); Density = 0.38; AtmosphereColor = rgb(220, 226, 236); CloudCover = 0.7; CloudColor = rgb(236, 240, 248); Tint = rgb(244, 248, 255); };
				Night = { OutdoorAmbient = rgb(110, 124, 170); ExposureCompensation = 0.4; };
				Witching = { OutdoorAmbient = rgb(100, 112, 160); ExposureCompensation = 0.35; };
			};
		};
		Spring = {
			Skies = { Day = `SpringDay`; Dusk = `SpringDusk`; Night = `SpringNight` };
			Looks = {
