local P=game.ServerStorage.NHProps
local kit={"DormBed","DormBedUnmade","DormDesk","DormChair","DormWardrobe","DormWardrobeOpen","DormShelfFull","DormShelfSparse","DormShelfEmpty","DormPlantHealthy","DormPlantWilting","DormPlantDead","DormDeskLamp","DormCeilingLight","DormRug","CertificateHonourRoll","CertificateDeansList","CertificatePerfectAttendance","TrophyShelf","JacketOnChair","ClothesOnChair","DormBookStack","CoffeeCup","PaperScatter","ClothesPile","PizzaBoxes","OverdueNotices","EmptyCans","DormWall","DormWallWindow","DormWallDoor","DormFloor","DormCeiling","RoomNumberPlate","RoomNumberPlateBlank"}
local noCollide={DormDeskLamp=1,DormCeilingLight=1,DormRug=1,CertificateHonourRoll=1,CertificateDeansList=1,CertificatePerfectAttendance=1,TrophyShelf=1,JacketOnChair=1,ClothesOnChair=1,DormBookStack=1,CoffeeCup=1,PaperScatter=1,ClothesPile=1,PizzaBoxes=1,OverdueNotices=1,EmptyCans=1,RoomNumberPlate=1,RoomNumberPlateBlank=1,DormShelfFull=1,DormShelfSparse=1,DormShelfEmpty=1,DormPlantHealthy=1,DormPlantWilting=1,DormPlantDead=1}
local missing,used={},0
local KEY={color="ColorMap",normal="NormalMap",rough="RoughnessMap",metal="MetalnessMap"}
local function sa(part,set)
  local s=Instance.new("SurfaceAppearance")
  for _,k in ipairs({"color","normal","rough","metal"}) do
    local id=IDS[set.."_"..k]
    if id then s[KEY[k]]="rbxassetid://"..id used+=1
    elseif k~="metal" then table.insert(missing,set.."_"..k) end
  end
  s.Parent=part
end
local done=0
for _,n in ipairs(kit) do
  local m=workspace:FindFirstChild(n) or P:FindFirstChild(n)
  if m:GetScale()==1 and select(2,m:GetBoundingBox()).Magnitude>60 then m:ScaleTo(0.01) end
  for _,p in ipairs(m:GetDescendants()) do if p:IsA("MeshPart") then
    for _,o in ipairs(p:GetChildren()) do if o:IsA("SurfaceAppearance") then o:Destroy() end end
    p.Anchored=true p.PivotOffset=CFrame.new()
    local nm=p.Name
    if nm:match("_Glow$") then p.Material=Enum.Material.Neon p.Color=Color3.fromRGB(255,214,160) p.CastShadow=false
    elseif nm:match("_Glass$") then p.Material=Enum.Material.Glass p.Transparency=0.45 p.CastShadow=false
      p.Color= nm:find("Window") and Color3.fromRGB(150,165,185) or Color3.fromRGB(245,235,215)
    elseif nm:match("_Plaster$") then sa(p,"NH_DormPlaster")
    elseif nm:match("_Panel$") then sa(p,"NH_DormEnamel")
    elseif n=="DormFloor" then sa(p,"NH_DormFloor")
    else sa(p,n) end
    if noCollide[n] then p.CanCollide=false p.CanTouch=false end
    if n=="DormRug" or n=="PaperScatter" then p.CastShadow=false end
  end end
  m:SetAttribute("NHBuildKit","Dorm")
  m.Parent=P
  done+=1
end
return "templates "..done.." maps set "..used.." missing: "..table.concat(missing,",")
